# Copy to .env, keep it private, and replace both credential placeholders.
# Single quotes preserve literal $ and # characters in Docker Compose .env values.
MINIFILES_USERNAME='CHANGE_ME'
MINIFILES_PASSWORD='CHANGE_ME'

# These values must describe the same address used by your browser.
MINIFILES_ORIGIN=http://127.0.0.1:8090
MINIFILES_BIND_IP=127.0.0.1
MINIFILES_PORT=8090

# Numeric user/group with write access to data, settings and TLS directories.
MINIFILES_UID=1000
MINIFILES_GID=1000

# Use latest from main, or pin sha-<full commit> for controlled updates.
MINIFILES_IMAGE=ghcr.io/metalogico/minifiles:latest

# Create these directories explicitly before starting Docker Compose.
# For an existing disk, set DATA_PATH to its real, mounted directory.
MINIFILES_DATA_PATH=./local-data
MINIFILES_CONFIG_PATH=./local-config

MINIFILES_SESSION_SECONDS=43200
MINIFILES_UPLOAD_IDLE_SECONDS=120
# Concurrent reservations across pages; each page transfers one file at a time.
MINIFILES_MAX_UPLOADS=4
# 0 means no application file-size limit.
MINIFILES_MAX_UPLOAD_BYTES=0
MINIFILES_RESERVE_BYTES=1073741824

# Optional companion: enable only after following docs/BACKUPS.md.
# MINIFILES_SERVICE_PATH=/srv/minifiles
# MINIFILES_BACKUP_PATH=/mnt/backup/minifiles
# MINIFILES_BACKUP_VOLUME_ID=CHANGE_ME

# Optional Caddy HTTPS: use compose.yaml + compose.https.yaml (docs/INSTALL.md).
# Set ORIGIN above to https://<TLS_HOST>:<PORT> before enabling it.
MINIFILES_TLS_HOST=127.0.0.1
MINIFILES_TLS_PATH=./tls-data
